# Optional. Vercel Analytics works without this value.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Supabase. For local development run `npx supabase start` and copy the
# printed API URL, publishable key, and secret key. The secret key is
# server-only — never expose it with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
