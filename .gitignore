# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.brand-build/

# misc
.DS_Store
*.pem
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Paste-ready migration bundles, assembled for the Supabase SQL editor and
# deleted after they are run. A stale copy of migration SQL living in the repo
# is the one someone runs by mistake six weeks later; supabase/migrations is
# the only place schema belongs.
supabase/APPLY_TO_PRODUCTION.sql
